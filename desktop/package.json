{
  "name": "timkiemvanban",
  "version": "1.0.0",
  "description": "Tim Kiem Van Ban - luu tru va tim kiem van ban offline",
  "main": "main.js",
  "author": "Hi",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "dist": "electron-builder --win portable --x64 --publish never" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "vn.timkiemvanban.desktop",
    "productName": "TimKiemVanBan",
    "files": ["main.js", "preload.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "TimKiemVanBan.exe" },
    "asar": true
  }
}
